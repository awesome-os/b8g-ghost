/**
 * @file sections/b8g-ghost/ghost-gen.mts
 * @description Generates C11 `b8g_ghost_spec_t` definitions directly from any
 * `RollingReleaseManifest.json` (e.g. awesome-os/sectium-browser @ v0.5.0-baseline).
 */
import { readFileSync } from 'node:fs';

interface ManifestComponent {
  filename: string;
  sha256: string;
  download_url: string;
  role: string;
}

export function generateGhostSpecsHeader(manifestJson: string): string {
  const m = JSON.parse(manifestJson) as { baseline_tag: string; components: ManifestComponent[] };
  const libs = m.components.filter(
    (c) => c.filename.endsWith('.dll') || c.filename.endsWith('.so') || c.filename.endsWith('.dylib')
  );
  const lines = [
    `/* Auto-generated by b8g-ghost/ghost-gen.mts from baseline ${m.baseline_tag} */`,
    '#pragma once',
    '#include "b8g_ghost.h"',
    '',
  ];
  for (const lib of libs) {
    const sym = lib.filename.replace(/[^a-zA-Z0-9]/g, '_').toUpperCase();
    lines.push(
      `static const b8g_ghost_spec_t GHOST_SPEC_${sym} = {`,
      `  .abi_magic = B8G_ABI_MAGIC_V3,`,
      `  .ghost_magic = B8G_GHOST_MAGIC,`,
      `  .filename = "${lib.filename}",`,
      `  .sha256_hex = "${lib.sha256}",`,
      `  .download_url = "${lib.download_url}"`,
      `};`,
      ''
    );
  }
  return lines.join('\n');
}

if (process.argv[1]?.endsWith('ghost-gen.mts') && process.argv[2]) {
  console.log(generateGhostSpecsHeader(readFileSync(process.argv[2], 'utf8')));
}
